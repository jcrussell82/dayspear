{
  "name": "dayspear",
  "version": "0.2.0",
  "private": true,
  "description": "DaySpear — team scheduling, made simple. Static site (GitHub Pages) + Supabase.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs --single",
    "serve": "node build.mjs && node serve.mjs",
    "test": "node --test test/*.test.mjs",
    "stack": "bash test/stack/stack.sh start",
    "stack:stop": "bash test/stack/stack.sh stop"
  }
}
